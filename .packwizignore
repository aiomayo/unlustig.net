# .packwizignore follows the same format as .gitignore, and can be used to exclude unwanted files from pack exports
# See https://git-scm.com/docs/gitignore

# Repository metadata -- not part of the pack
/README.md
/.github/

# Exclude exports so a previous build is never bundled into the next one.
# Anchored to the root so bundled content (e.g. resourcepacks/*.zip) still ships.
/*.mrpack
/*.zip
/dist/
